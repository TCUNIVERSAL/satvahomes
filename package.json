{
  "name": "satvahomes",
  "version": "1.0.0",
  "private": true,
  "description": "Coral Homes - External Selections 3D",
  "scripts": {
    "postinstall": "npm --prefix \"coral homes\" install",
    "dev": "npm --prefix \"coral homes\" run dev",
    "start": "npm --prefix \"coral homes\" run dev",
    "build": "npm --prefix \"coral homes\" run build && node -e \"const fs = require('fs'); fs.cpSync('coral homes/dist', 'dist', { recursive: true });\"",
    "preview": "npm --prefix \"coral homes\" run preview"
  }
}
